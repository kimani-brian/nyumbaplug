# ============================================================
# NyumbaPlug — local development configuration (template)
# Copy to .env and adjust. For production, copy .env.production.
# ============================================================

PORT=8081
# Postgres runs on 5434 in dev. Default uses Unix socket peer auth; for TCP use
# postgres://USER:PASS@localhost:5434/kenyahouses?sslmode=disable
DATABASE_URL=postgres://brian@/kenyahouses?host=/var/run/postgresql&port=5434&sslmode=disable
JWT_SECRET=super-secret-jwt-key-change-in-production
ENVIRONMENT=development

# Admin bootstrap — used by both the seed script and server startup hook.
# In production, set these via environment variables (never commit them).
ADMIN_EMAIL=admin@nyumbaplug.com
ADMIN_PASSWORD=set-a-strong-password-here

# ------------------------------------------------------------
# Email OTP verification via Resend (https://resend.com).
# ------------------------------------------------------------
# Local dev:
#   - Leave RESEND_API_KEY empty to use a no-op sender that only logs
#     codes to the server console.
#   - Or set a key and use the sandbox sender onboarding@resend.dev, which
#     delivers only to the email your Resend account was created with.
# Production (see .env.production):
#   - Verify a real domain in Resend (SPF/DKIM/DMARC).
#   - RESEND_FROM_EMAIL="NyumbaPlug <noreply@yourdomain.com>"
#   - ENVIRONMENT=production (disables console OTP logging)
RESEND_API_KEY=
RESEND_FROM_EMAIL="NyumbaPlug <onboarding@resend.dev>"
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
